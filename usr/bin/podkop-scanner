#!/bin/sh
RESULTS="/www/podkop_nodes.json"
RAW_FILE="/tmp/sub_raw.txt"
CONVERTER="/usr/bin/podkop-json2vless"
URLS=$(uci -q get podkop_manager.main.subscription_url)

[ -z "$URLS" ] && echo "[]" > $RESULTS && exit 1
echo "[" > $RESULTS
FIRST=1

for URL in $URLS; do
    curl -L -s -k -H "User-Agent: Happ/3.13.0" "$URL" -o "$RAW_FILE"
    sed 's/{"dns":/\n{"dns":/g' "$RAW_FILE" | grep "{\"dns\":" | while read -r line; do
        V=$(echo "$line" | $CONVERTER 2>/dev/null)
        [ -z "$V" ] && continue
        N=$(echo "$line" | sed -n 's/.*"remarks":"\([^"]*\)".*/\1/p'); [ -z "$N" ] && N="Node"
        A=$(echo "$line" | sed -n 's/.*"address":"\([^"]*\)".*/\1/p')
        L=$(ping -c 1 -W 1 "$A" 2>/dev/null | awk -F "/" 'END {print $5}'); [ -z "$L" ] && L="0"
        [ "$FIRST" -ne 1 ] && echo "," >> $RESULTS
        printf '{"name":"%s","addr":"%s","latency":"%s","raw":"%s"}' "$N" "$A" "$L" "$V" >> $RESULTS
        FIRST=0
    done
done
echo "]" >> $RESULTS
chmod 644 $RESULTS
